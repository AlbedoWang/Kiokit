    "rslib/src/backend/mod.rs",
    "rslib/rust_interface.rs",
    "rslib/proto_gen/src/lib.rs",
    "proto/anki"
  ],
  "frontend_adaptations": [
    "qt/aqt/reviewer.py::V3CardInfo.from_queue, set_scheduling_states, RUN_STATE_MUTATION",
    "qt/aqt/reviewer.py::op_executed, refresh_if_needed, _redraw_current_card, cleanup",
    "qt/aqt/undo.py::UndoActionsInfo.from_undo_status",
    "qt/aqt/filtered_deck.py and qt/aqt/forms/filtered_deck.ui",
    "pylib/anki/cards.py::current_deck_id, autoplay, replay_question_audio_on_answer_side",
    "pylib/anki/decks.py::config_dict_for_deck_id",
    "pylib/anki/collection.py::set_config",
    "qt/aqt/reviewer.py::typeAnsQuestionFilter, typeAnsAnswerFilter, _contentForCloze",
    "qt/aqt/mediasrv.py::get_scheduling_states_with_context, set_scheduling_states",
    "qt/aqt/main.py::prepare_card_text_for_display, _add_play_buttons",
    "qt/aqt/sound.py::av_refs_to_play_icons",
    "qt/aqt/sound.py::AVPlayer, SoundOrVideoPlayer, MpvManager, setup_audio, is_audio_file",
    "qt/aqt/tts.py::TTSPlayer.voice_for_tag",
    "pylib/anki/sound.py::AV_REF_RE, strip_av_refs",
    "pylib/anki/template.py::render, apply_custom_filters (Card Details omits native FrontSide replacement nodes in its Back panel only)",
    "pylib/anki/template.py::av_tag_to_native",
    "pylib/anki/latex.py::render_latex_returning_errors, _save_latex_image, _err_msg",
    "pylib/anki/utils.py::call, tmpdir, namedtmp",
    "qt/aqt/main.py::onOpenBackup, _start_restore_backup",
    "qt/aqt/mediasrv.py::_mime_for_path, _strip_csp_meta, _handle_builtin_file_request",
    "qt/aqt/webview.py::AnkiWebView.on_theme_did_change (exact script, source-method verification)",
    "qt/aqt/stats.py::NewDeckStats.refresh, _on_bridge_cmd",
    "ts/routes/graphs and ts/lib/sveltelib/preferences.ts (unmodified compiled assets)",
    "ts/routes/graphs/ReviewsGraph.svelte, FutureDue.svelte, AddedGraph.svelte (presentation-only selection, typography and rounded bars)",
    "ts/routes/graphs/histogram-graph.ts, HoverColumns.svelte, Tooltip.svelte and GraphsPage.svelte (original click handlers; mobile hover suppression)",
    "ftl/core/statistics.ftl and generated/_fluent.py accessors (native graph title translations)",
    "rslib/src/notes/mod.rs::canonify_note_tags and rslib/src/tags/register.rs::canonify_tags",
    "qt/aqt/reviewer.py::_get_next_v3_card, pylib/anki/cards.py::start_timer, time_taken",
    "pylib/anki/scheduler/v3.py::build_answer and rslib/src/scheduler/answering/mod.rs::cap_answer_secs",
    "qt/aqt/reviewer.py::_showAnswerButton, _showEaseButtons and qt/aqt/data/web/js/reviewer-bottom.ts (unmodified compiled asset)",
    "qt/aqt/browser/browser.py::delete_selected_notes and qt/aqt/operations/note.py::remove_notes",
    "qt/aqt/reviewer.py::_answerCard and answer_card(...).run_in_background (platform task binding)",
    "rslib/src/notetype/render.rs::render_existing_card, add_special_fields (read-only display cache inputs)",
    "rslib/src/storage/card/get_card.sql and rslib/src/storage/note/get.sql (read-only cache fingerprints through the upstream DB proxy)",
    "rslib/src/browser_table.rs::RenderContext.side_str and rslib/src/text.rs::html_to_text_line (native list previews)"
  ]
